# OpenSearch
OPENSEARCH_URL=https://localhost:9200
OPENSEARCH_USERNAME=admin
OPENSEARCH_PASSWORD=replace-me
OPENSEARCH_VERIFY_CERTS=false
OPENSEARCH_INDEX=rag-documents
OPENSEARCH_TIMEOUT=60

# Local sentence-transformer models
EMBEDDING_MODEL_PATH=./models/all-mpnet-base-v2
EMBEDDING_DIMENSION=768
RERANKER_MODEL_PATH=./models/ms-marco-MiniLM-L-6-v2

# Embedding behavior
EMBEDDING_BATCH_SIZE=16
NORMALIZE_EMBEDDINGS=true

# Chunking
CHUNK_SIZE=250
CHUNK_OVERLAP=40

# Retrieval
BM25_TOP_K=20
EMBEDDING_TOP_K=20
RERANK_TOP_K=5
ENABLE_RERANKER=true

# Enforce offline Hugging Face behavior
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
