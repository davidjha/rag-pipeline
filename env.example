# Choose: opensearch or in_memory
STORE_BACKEND=in_memory
#In-memory persistence
IN_MEMORY_STORE_PATH=./data/in-memory-document-store.json
IN_MEMORY_PERSIST=true

# OpenSearch
OPENSEARCH_URL=https://localhost:9200
OPENSEARCH_USERNAME=admin
OPENSEARCH_PASSWORD=replace-me
OPENSEARCH_VERIFY_CERTS=false
OPENSEARCH_CA_CERTS=replace-me
OPENSEARCH_INDEX=rag-documents
OPENSEARCH_TIMEOUT=60

# Documents directory
DOCUMENTS_ROOT="./documents"

# Local sentence-transformer models
EMBEDDING_MODEL=./models/all-mpnet-base-v2
EMBEDDING_DIM=768
RERANKER_ENABLED=true
RERANKER_MODEL=./models/ms-marco-MiniLM-L-6-v2

#LLM Inference server
LLM_BASE_URL=http://localhost:8033/v1
LLM_MODEL=local-chat
LLM_API_KEY='replace-with-a-random-secret'

RAG_API_KEY='replace-with-a-random-secret'
RAG_AUTH_ENABLED=true

# Embedding behavior
EMBEDDING_BATCH_SIZE=16
NORMALIZE_EMBEDDINGS=true

# Chunking
CHUNK_SIZE=250
CHUNK_OVERLAP=40

# Retrieval
BM25_TOP_K=20
EMBEDDING_TOP_K=20
RERANK_TOP_K=5

# Enforce offline Hugging Face behavior
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_HUB_DISABLE_TELEMETRY=1
HAYSTACK_TELEMETRY_ENABLED=False
